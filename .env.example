# ==============================================================================
# SafeBite AI — Backend Environment Configuration Example
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in the required secrets for your production / staging deployment.
# 3. NEVER commit the real '.env' file or production credentials to GitHub!
# ==============================================================================

# Server Hosting Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Security & Authentication (Required in Production)
# Cryptographically strong secret key used for HMAC-SHA256 JWT access tokens.
AUTH_SECRET_KEY=your_cryptographically_random_auth_secret_key_here
ADMIN_SECRET=your_admin_secret_key_here

# Database Configuration
# MongoDB connection URI (e.g. MongoDB Atlas cluster or local MongoDB instance).
# If unset, SafeBite automatically falls back to local SQLite (safebite.db).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/safebite?retryWrites=true&w=majority
DATABASE_NAME=safebite
DATABASE_URL=sqlite:///./safebite.db

# Google Gemini AI Integration (Required for Food Vision & Multimodal Analysis)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary Image Storage (Optional - falls back to on-device/local storage if unconfigured)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Verification (Optional - falls back to console logger in dev/testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=noreply@safebite.app

# Google Play Developer API (For server-side Google Play Billing subscription verification)
# Path to service account JSON or base64-encoded credentials:
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.example.safebite
